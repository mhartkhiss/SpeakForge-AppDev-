<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:padding="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="#87CEEB"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Reply Preview Container -->
            <LinearLayout
                android:id="@+id/replyPreviewContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@drawable/reply_preview_background"
                android:elevation="2dp"
                android:padding="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/textViewReplySender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original Sender"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/textViewReplyContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original message content"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0" />

            </LinearLayout>

            <TextView
                android:id="@+id/textViewMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:maxWidth="260dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="Sample message"
                android:textColor="#000000"
                android:textSize="15sp" />

            <com.example.appdev.utils.LoadingDotsView
                android:id="@+id/loadingDots"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingVertical="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone"
                app:dotColor="#2196F3"
                app:dotSize="8sp"
                app:animationDuration="400"
                app:animationDelay="300"
                app:scaleMultiplier="2.0"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
