<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Header Background with curved bottom -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/profile_header_background" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">

            <!-- Profile Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_centerHorizontal="true"
                android:text="My Profile"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_semibold" />

            <!-- Profile Picture with larger size and elevation -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imageViewUserPicture"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="90dp"
                android:src="@drawable/default_userpic"
                android:elevation="4dp"
                app:civ_border_color="#FFFFFF"
                app:civ_border_width="4dp" />

            <!-- Main Card with improved styling -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageViewUserPicture"
                android:layout_marginTop="-30dp"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Name with larger text -->
                    <TextView
                        android:id="@+id/textViewUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textSize="24sp"
                        android:textColor="#212121"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_semibold"/>

                    <!-- Email with improved styling -->
                    <TextView
                        android:id="@+id/textViewEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:fontFamily="@font/poppins"
                        android:layout_marginBottom="24dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="24dp"
                        android:background="#E0E0E0" />

                    <!-- Profile Options with improved button styling -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <!-- Change Password Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMenuChangePassword"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="#F8F9FA"
                            android:text="Change Password"
                            android:textColor="#212121"
                            android:fontFamily="@font/poppins_medium"
                            android:textAlignment="textStart"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            app:icon="@drawable/profile_password"
                            app:iconGravity="start"
                            app:iconPadding="24dp"
                            app:iconSize="24dp"
                            app:iconTint="#424242"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            app:cornerRadius="12dp"/>

                        <!-- Change Language Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMenuChangeLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="#F8F9FA"
                            android:text="Change Language"
                            android:textColor="#212121"
                            android:fontFamily="@font/poppins_medium"
                            android:textAlignment="textStart"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            app:icon="@drawable/profile_language"
                            app:iconGravity="start"
                            app:iconPadding="24dp"
                            app:iconSize="24dp"
                            app:iconTint="#424242"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            app:cornerRadius="12dp"/>

                        <!-- Translator Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMenuSelectTranslator"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="12dp"
                            android:backgroundTint="#F8F9FA"
                            android:text="Translator: Google Translate"
                            android:textColor="#212121"
                            android:fontFamily="@font/poppins_medium"
                            android:textAlignment="textStart"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            app:icon="@drawable/ic_translate"
                            app:iconGravity="start"
                            app:iconPadding="24dp"
                            app:iconSize="24dp"
                            app:iconTint="#424242"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            app:cornerRadius="12dp"/>

                        <!-- Logout Button with improved styling -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogout"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="Logout"
                            android:textColor="#FF5252"
                            android:fontFamily="@font/poppins_medium"
                            android:textAlignment="textStart"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            app:icon="@drawable/profile_logout"
                            app:iconGravity="start"
                            app:iconPadding="24dp"
                            app:iconSize="24dp"
                            app:iconTint="#FF5252"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            app:cornerRadius="12dp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="#E0E0E0" />

                    <!-- Upgrade Button with gradient background -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUpgrade"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:text="Upgrade to Premium"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/poppins_medium"
                        app:icon="@drawable/premium1"
                        app:iconGravity="textStart"
                        app:iconTint="#FFD700"
                        app:iconPadding="24dp"
                        app:cornerRadius="12dp"
                        android:backgroundTint="#2196F3"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Change Username Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewChangeUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageViewUserPicture"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="15dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change Username"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputLayoutUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Display Name"
                            android:textColor="@color/black"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveChanges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Changes"
                        android:textColor="#FFFFFF"
                        android:padding="12dp"
                        app:cornerRadius="12dp"
                        android:backgroundTint="#2196F3"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Include other layouts -->
            <include
                android:id="@+id/includeChangePassword"
                layout="@layout/fragment_profile_sub_changepass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageViewUserPicture"
                android:visibility="gone" />

            <include
                android:id="@+id/includeLanguageSelection"
                layout="@layout/fragment_profile_sub_changelanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageViewUserPicture"
                android:visibility="gone" />

            <include
                android:id="@+id/includeTranslatorSelection"
                layout="@layout/fragment_profile_sub_changetranslator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageViewUserPicture"
                android:visibility="gone" />

        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
