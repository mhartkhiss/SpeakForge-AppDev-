<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sub_fragment_header_background"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Translator"
                android:textColor="#212121"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_semibold" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="#212121" />
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                android:text="Google Translate"
                android:textColor="#212121"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAlignment="textStart"
                app:icon="@drawable/translator_icon_google"
                app:iconGravity="start"
                app:iconSize="32dp"
                app:iconPadding="24dp"
                app:iconTint="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#E0E0E0"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAi"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="16dp"
                android:text="OpenAI Translator"
                android:textColor="#212121"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAlignment="textStart"
                app:icon="@drawable/translator_icon_openai"
                app:iconGravity="start"
                app:iconSize="32dp"
                app:iconPadding="24dp"
                app:iconTint="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#E0E0E0"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeepSeek"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:text="DeepSeek Translator"
                android:textColor="#212121"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAlignment="textStart"
                app:icon="@drawable/translator_icon_deepseek"
                app:iconGravity="start"
                app:iconSize="32dp"
                app:iconPadding="24dp"
                app:iconTint="@null"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#E0E0E0"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView> 