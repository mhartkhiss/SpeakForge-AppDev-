<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="sequentially">
    <!-- First, scale up and rotate slightly -->
    <set android:ordering="together">
        <objectAnimator
            android:duration="300"
            android:propertyName="scaleX"
            android:valueTo="1.1"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="300"
            android:propertyName="scaleY"
            android:valueTo="1.1"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="300"
            android:propertyName="rotation"
            android:valueTo="15"
            android:valueType="floatType" />
    </set>
    <!-- Then, rotate back and scale down slightly -->
    <set android:ordering="together">
        <objectAnimator
            android:duration="300"
            android:propertyName="rotation"
            android:valueTo="-15"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="300"
            android:propertyName="scaleX"
            android:valueTo="1.05"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="300"
            android:propertyName="scaleY"
            android:valueTo="1.05"
            android:valueType="floatType" />
    </set>
    <!-- Finally, return to normal state -->
    <set android:ordering="together">
        <objectAnimator
            android:duration="300"
            android:propertyName="rotation"
            android:valueTo="0"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="300"
            android:propertyName="scaleX"
            android:valueTo="1.0"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="300"
            android:propertyName="scaleY"
            android:valueTo="1.0"
            android:valueType="floatType" />
    </set>
</set>
