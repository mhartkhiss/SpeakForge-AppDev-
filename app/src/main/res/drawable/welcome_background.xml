<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#FFFAF1"/>
        </shape>
    </item>
    <!-- Top right decorative circle -->
    <item android:right="-180dp" android:top="-120dp">
        <shape android:shape="oval">
            <solid android:color="#140E7FDA"/>
            <size android:width="300dp" android:height="300dp"/>
        </shape>
    </item>
    <!-- Bottom left decorative circle -->
    <item android:left="-180dp" android:bottom="-150dp">
        <shape android:shape="oval">
            <solid android:color="#08FF9800"/>
            <size android:width="300dp" android:height="300dp"/>
        </shape>
    </item>
</layer-list> 