<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#FAFAFA"/>
        </shape>
    </item>
    <!-- Top right decorative circle -->
    <item android:right="-180dp" android:top="-120dp">
        <shape android:shape="oval">
            <solid android:color="#252196F3"/>
            <size android:width="350dp" android:height="350dp"/>
        </shape>
    </item>
    <!-- Bottom left decorative circle -->
    <item android:left="-180dp" android:bottom="-150dp">
        <shape android:shape="oval">
            <solid android:color="#15FF9800"/>
            <size android:width="350dp" android:height="350dp"/>
        </shape>
    </item>
    <!-- Small accent circle top left -->
    <item android:left="30dp" android:top="100dp">
        <shape android:shape="oval">
            <solid android:color="#152196F3"/>
            <size android:width="20dp" android:height="20dp"/>
        </shape>
    </item>
    <!-- Small accent circle bottom right -->
    <item android:right="40dp" android:bottom="120dp">
        <shape android:shape="oval">
            <solid android:color="#15FF9800"/>
            <size android:width="15dp" android:height="15dp"/>
        </shape>
    </item>
</layer-list>